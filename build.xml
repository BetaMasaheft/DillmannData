<?xml version="1.0" encoding="UTF-8"?>
<project default="xar" name="dill-data">
    <xmlproperty file="expath-pkg.xml"/>
    <property name="project.version" value="${package(version)}"/>
    <property name="project.app" value="dill-data"/>
    <property name="build.dir" value="build"/>
    <target name="clean" description="delete all build artefacts">
        <delete includeemptydirs="true" failonerror="false">
            <fileset dir="${build.dir}" includes="**/*" />
        </delete>
    </target>
    <target name="xar" depends="clean">
        <mkdir dir="${build.dir}/tmp"/>
        <copy todir="${build.dir}/tmp">
            <fileset dir="." defaultexcludes="true">
                <exclude name=".github/"/>
            </fileset>
        </copy>
        <copy todir="${build.dir}/tmp">
            <fileset dir="${build.dir}/tmp/data/" />
        </copy> 
        <delete dir="${build.dir}/tmp/data"/>
        <delete dir="${build.dir}/tmp/build"/>
        <zip basedir="${build.dir}/tmp" destfile="${build.dir}/${project.app}.xar" excludes="compare.sh" />
        <delete dir="${build.dir}/tmp"/>
    </target>
</project>